# Copie para ".env" e ajuste. Sem estes valores, no desenvolvimento o app procura a API
# (porta 5135) e o site (porta 5173) no mesmo computador que roda o "npm start".

# Endereço da API, sem barra no final. Em produção, sempre https.
EXPO_PUBLIC_API_URL=

# Endereço do site (o app usa o OpenCV.js dele na medição da prótese). Padrão: o domínio da API.
EXPO_PUBLIC_SITE_URL=

# WhatsApp da clínica (somente dígitos, com DDI e DDD). Vazio esconde os botões de WhatsApp.
EXPO_PUBLIC_WHATSAPP=
